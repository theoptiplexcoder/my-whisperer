#!/bin/bash

set -e

VOICE_DIR="$HOME/.cache/voiceprompt"
AUDIO="$VOICE_DIR/recording.wav"
PIDFILE="$VOICE_DIR/record.pid"
TEXT="$VOICE_DIR/result.txt"
ENGINE_FILE="$VOICE_DIR/engine"

# Engine paths
NEEDLE_BIN="/home/ybl/proj/my-voice-capture/my-whisperer/bin/needle"
WHISTLE_MODEL="/home/ybl/proj/my-voice-capture/my-whisperer/models/whistle.cact"

WHISPER_BIN="/home/ybl/proj/my-voice-capture/my-whisperer/bin/whisper-cli"
WHISPER_MODEL="/home/ybl/proj/my-voice-capture/my-whisperer/models/ggml-base.en.bin"

if [[ ! -f "$PIDFILE" ]]; then
    exit 0
fi

PID=$(cat "$PIDFILE")
rm -f "$PIDFILE"

# Stop recording
if kill -0 "$PID" 2>/dev/null; then
    kill -INT "$PID" 2>/dev/null || true
    while kill -0 "$PID" 2>/dev/null; do
        sleep 0.1
    done
fi

# Make sure recording has actual audio data (WAV header is 44 bytes)
AUDIO_SIZE=$(stat -c%s "$AUDIO" 2>/dev/null || echo 0)
if (( AUDIO_SIZE <= 44 )); then
    notify-send -h string:x-canonical-private-synchronous:voiceprompt -t 1500 "Voice Input" "No audio recorded"
    exit 1
fi

notify-send \
    -h string:x-canonical-private-synchronous:voiceprompt \
    -t 1200 \
    "Voice Input" \
    "Transcribing..."

rm -f "$TEXT"

ENGINE="cactus"
if [[ -f "$ENGINE_FILE" ]]; then
    ENGINE=$(cat "$ENGINE_FILE" | tr -d '[:space:]')
fi

if [[ "$ENGINE" == "whisper" ]]; then
    # Run whisper.cpp
    "$WHISPER_BIN" \
        -m "$WHISPER_MODEL" \
        -f "$AUDIO" \
        -l en \
        -ng \
        -t 4 \
        -bs 1 \
        -bo 1 \
        -nt \
        -np \
        -of "$VOICE_DIR/result" \
        -otxt \
        > "$VOICE_DIR/whisper.log" 2>&1 || true

    if [[ -f "$TEXT" ]]; then
        RAW_TEXT=$(cat "$TEXT" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    else
        RAW_TEXT=""
    fi
else
    # Run Cactus Whistle transcription
    NEEDLE_OUT=$("$NEEDLE_BIN" --model "$WHISTLE_MODEL" --audio "$AUDIO" --audio-language en 2>"$VOICE_DIR/whisper.log" || true)

    RAW_TEXT=$(python3 -c "
import json, sys
try:
    data = json.loads(sys.argv[1])
    print(data.get('text', '').strip())
except Exception:
    pass
" "$NEEDLE_OUT")
fi

if [[ -z "$RAW_TEXT" ]]; then
    notify-send -h string:x-canonical-private-synchronous:voiceprompt -t 1500 "Voice Input" "No speech detected"
    exit 0
fi

printf "%s" "$RAW_TEXT" > "$TEXT"
# Format keyboard shortcuts if spoken (e.g., SuperPlusM -> Super+M, ControlPlusC -> Ctrl+C)
CLEANED_TEXT=$(python3 -c "
import sys, re

text = sys.stdin.read().strip()
if not text:
    sys.exit(0)

pattern_plus = r'\b(Super|Ctrl|Control|Alt|Shift|Cmd|Command|Win|Windows|Meta)(?:Plus(?:Super|Ctrl|Control|Alt|Shift|Cmd|Command|Win|Windows|Meta|[A-Za-z0-9]|F[1-9]|F1[0-2]|Enter|Space|Tab|Esc|Escape|Backspace|Delete))+\b'
def replace_camel(m):
    parts = m.group(0).split('Plus')
    return '+'.join([p.capitalize() if len(p) > 1 else p.upper() for p in parts])
text = re.sub(pattern_plus, replace_camel, text, flags=re.IGNORECASE)

pattern_spoken = r'\b(super|ctrl|control|alt|shift|cmd|command|win|windows|meta)\s+plus\s+([a-zA-Z0-9]+(?:\s+plus\s+[a-zA-Z0-9]+)*)\b'
def replace_spoken(m):
    words = re.split(r'\s+plus\s+', m.group(0), flags=re.IGNORECASE)
    formatted = []
    for w in words:
        w_lower = w.lower()
        if w_lower in ('control', 'ctrl'): formatted.append('Ctrl')
        elif w_lower in ('super', 'win', 'windows', 'meta', 'cmd', 'command', 'alt', 'shift', 'enter', 'space', 'tab', 'esc', 'escape'): formatted.append(w.capitalize())
        elif len(w) == 1: formatted.append(w.upper())
        else: formatted.append(w)
    return '+'.join(formatted)
text = re.sub(pattern_spoken, replace_spoken, text, flags=re.IGNORECASE)
text = re.sub(r'\bControl\+', 'Ctrl+', text)

sys.stdout.write(text)
" <<< "$RAW_TEXT")

printf "%s" "$CLEANED_TEXT" > "$TEXT"

if [[ ! -s "$TEXT" ]]; then
    notify-send -h string:x-canonical-private-synchronous:voiceprompt -t 1500 "Voice Input" "No speech detected"
    exit 0
fi

# Copy transcription to Wayland clipboard
wl-copy < "$TEXT"

notify-send \
    -h string:x-canonical-private-synchronous:voiceprompt \
    -t 1500 \
    "Voice Input" \
    "$(cat "$TEXT")"
